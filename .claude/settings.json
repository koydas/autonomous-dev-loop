{
  "permissions": {
    "allow": [
      "Bash(node --test *)",
      "Bash(node --test scripts/tests/*.test.mjs)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // \"\"'); if echo \"$f\" | grep -qE '(scripts/|\\.github/workflows/)'; then node --test scripts/tests/*.test.mjs; fi",
            "timeout": 60,
            "statusMessage": "Running test suite..."
          }
        ]
      }
    ]
  }
}
