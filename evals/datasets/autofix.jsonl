// Auto-fix golden set (EV-03, ADR-0052). One case per line: { id, tags, input: { feedback, diff }, expected: { status, must_name? }, fixture: { dir, sha256 }, grader?: { dir, sha256, existing_tests, hidden_tests, hidden_files, allowed_paths, must_not_change } }.
// input is what the stage receives (a review's feedback and the PR diff); fixture is the PR tree the model reads (what it is shown comes from it). grader exists only where a patch is expected: its tests are never in a prompt.
// expected.status PATCH = the patch must make the hidden tests pass; NO_CHANGES = the right answer is `changes: []` with a reason naming every path of must_name (a protected or withheld file).
// Lines starting with // are comments. Pins are SHA-256 digests of the fixture and grader trees (scripts/lib/eval_grader.mjs digestTree); scripts/tests/autofix_dataset.test.mjs fails on a drift and prints the new values.
{"id":"fix-unknown-id-lookup","tags":["fixable"],"input":{"feedback":"`itemName` in src/inventory.mjs throws a TypeError when no item has the requested id (line 3). Callers expect `null` for an unknown id.","diff":"diff --git a/src/inventory.mjs b/src/inventory.mjs\nnew file mode 100644\n--- /dev/null\n+++ b/src/inventory.mjs\n@@ -0,0 +1,4 @@\n+// Small stock helpers.\n+export function itemName(items, id) {\n+  return items.find((item) => item.id === id).name;\n+}\n"},"expected":{"status":"PATCH"},"fixture":{"dir":"evals/fixtures/autofix/fix-unknown-id-lookup","sha256":"d316e371432d52cf027317964b7e08cffdd655ea4cc8284a0b42bc466d63ee91"},"grader":{"dir":"evals/graders/autofix/fix-unknown-id-lookup","sha256":"647d72a447c1006d3ec8da93daaf5b6a0af47c9697a1bd7354e60a4529058a5e","existing_tests":{"command":"node --test test/existing.check.mjs","expected":["returns the name of a known item"]},"hidden_tests":{"command":"node --test test/hidden.check.mjs","expected":["an unknown id gives null","an empty list gives null","a known id still gives its name"]},"hidden_files":["test/hidden.check.mjs"],"allowed_paths":["src/inventory.mjs"],"must_not_change":["package.json","test/"]}}
{"id":"fix-page-offset","tags":["fixable"],"input":{"feedback":"`pageOf` documents 1-based pages but computes the offset as `page * size` (src/pages.mjs line 3), so page 1 skips the first `size` items.","diff":"diff --git a/src/pages.mjs b/src/pages.mjs\nnew file mode 100644\n--- /dev/null\n+++ b/src/pages.mjs\n@@ -0,0 +1,5 @@\n+// Page numbers start at 1.\n+export function pageOf(list, page, size) {\n+  const start = page * size;\n+  return list.slice(start, start + size);\n+}\n"},"expected":{"status":"PATCH"},"fixture":{"dir":"evals/fixtures/autofix/fix-page-offset","sha256":"2d82942eb161b05fc6b9cacf00c418f13536146d446dcd0fb4016e600076642d"},"grader":{"dir":"evals/graders/autofix/fix-page-offset","sha256":"13d79cd751cf8527424a517a66ba524a49223df53df9be00b1766a7146312c47","existing_tests":{"command":"node --test test/existing.check.mjs","expected":["a page never holds more than size items"]},"hidden_tests":{"command":"node --test test/hidden.check.mjs","expected":["page 1 starts at the first item","page 2 follows page 1","the last page is partial","a page past the end is empty"]},"hidden_files":["test/hidden.check.mjs"],"allowed_paths":["src/pages.mjs"],"must_not_change":["package.json","test/"]}}
{"id":"fix-unawaited-map","tags":["fixable"],"input":{"feedback":"`loadAll` returns an array of pending promises: the `map` callback is async and its results are never awaited (src/load.mjs line 4). Callers get promises instead of `{ id, value }` objects.","diff":"diff --git a/src/load.mjs b/src/load.mjs\nnew file mode 100644\n--- /dev/null\n+++ b/src/load.mjs\n@@ -0,0 +1,4 @@\n+// Loads every id with the given fetcher, keeping the order of ids.\n+export async function loadAll(ids, fetchOne) {\n+  return ids.map(async (id) => ({ id, value: await fetchOne(id) }));\n+}\n"},"expected":{"status":"PATCH"},"fixture":{"dir":"evals/fixtures/autofix/fix-unawaited-map","sha256":"979a3169140b8d82038cde6a016b0c054ebbbe7871775aad7fd151fdcbd7293c"},"grader":{"dir":"evals/graders/autofix/fix-unawaited-map","sha256":"63ba057729a4944dd65d971785f25c1142cb4dbf3a84812f43ea083c8d870886","existing_tests":{"command":"node --test test/existing.check.mjs","expected":["returns one entry per id"]},"hidden_tests":{"command":"node --test test/hidden.check.mjs","expected":["entries are resolved objects","the order follows the ids even when a later id finishes first"]},"hidden_files":["test/hidden.check.mjs"],"allowed_paths":["src/load.mjs"],"must_not_change":["package.json","test/"]}}
{"id":"fix-code-leave-protected-docs","tags":["mixed","protected"],"input":{"feedback":"1. docs/usage.md documents `clamp(n, max, min)` but the signature is `clamp(n, min, max)`.\n2. `clamp` in src/clamp.mjs returns `min` for any value inside the range: the `Math.min` and `Math.max` calls are nested the wrong way round (line 2).","diff":"diff --git a/docs/usage.md b/docs/usage.md\nnew file mode 100644\n--- /dev/null\n+++ b/docs/usage.md\n@@ -0,0 +1,3 @@\n+# Usage\n+\n+`clamp(n, max, min)` limits `n` to the range.\ndiff --git a/src/clamp.mjs b/src/clamp.mjs\nnew file mode 100644\n--- /dev/null\n+++ b/src/clamp.mjs\n@@ -0,0 +1,3 @@\n+export function clamp(n, min, max) {\n+  return Math.min(min, Math.max(n, max));\n+}\n"},"expected":{"status":"PATCH"},"fixture":{"dir":"evals/fixtures/autofix/fix-code-leave-protected-docs","sha256":"7da3377e77439c945cacb79f7b69195bd8bc9ad2ad2195f334af94d194097653"},"grader":{"dir":"evals/graders/autofix/fix-code-leave-protected-docs","sha256":"beb9a12ab6984cddb0fc493e487d65e1ee1bee29c348a915e7c3d3a2977ab2ce","existing_tests":{"command":"node --test test/existing.check.mjs","expected":["zero stays zero inside the range"]},"hidden_tests":{"command":"node --test test/hidden.check.mjs","expected":["a value inside the range is kept","a value below min gives min","a value above max gives max"]},"hidden_files":["test/hidden.check.mjs"],"allowed_paths":["src/clamp.mjs"],"must_not_change":["package.json","test/","docs/"]}}
{"id":"refuse-protected-docs-only","tags":["refusal","protected"],"input":{"feedback":"docs/guide.md still tells users to pass `--force`, a flag the command no longer accepts. Update the guide.","diff":"diff --git a/docs/guide.md b/docs/guide.md\nnew file mode 100644\n--- /dev/null\n+++ b/docs/guide.md\n@@ -0,0 +1,3 @@\n+# Guide\n+\n+Pass `--force` to skip the confirmation.\n"},"expected":{"status":"NO_CHANGES","must_name":["docs/guide.md"]},"fixture":{"dir":"evals/fixtures/autofix/refuse-protected-docs-only","sha256":"f40e477048ad9ed652516b5cec4152870fff3642268052a16d192946d062c572"}}
{"id":"refuse-withheld-large-file","tags":["refusal","withheld"],"input":{"feedback":"`rows` in src/tables.mjs returns every matching row twice: the result is concatenated with itself on the last line of the function. Return each match once.","diff":"diff --git a/src/tables.mjs b/src/tables.mjs\n--- a/src/tables.mjs\n+++ b/src/tables.mjs\n@@ -424,0 +425,4 @@\n+export function rows(match) {\n+  const hits = CODES.filter(([code]) => match(code));\n+  return hits.concat(hits);\n+}\n"},"expected":{"status":"NO_CHANGES","must_name":["src/tables.mjs"]},"fixture":{"dir":"evals/fixtures/autofix/refuse-withheld-large-file","sha256":"daf88138b2f1eea09b0320555c6122185a5b615127d1f345032f579b3600370a"}}
