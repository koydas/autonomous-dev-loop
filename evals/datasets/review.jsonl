pectedMs: 140000 },\n+  { header: '157', at: '2026-06-11T11:53:00Z', zone: 'America/Sao_Paulo', expectedMs: 157000 },\n+  { header: '174', at: '2026-07-12T18:06:00Z', zone: 'UTC', expectedMs: 174000 },\n+  { header: '191', at: '2026-08-13T01:19:00Z', zone: 'Europe/Paris', expectedMs: 191000 },\n+  { header: '208', at: '2026-09-14T08:32:00Z', zone: 'America/New_York', expectedMs: 208000 },\n+  { header: '225', at: '2026-01-15T15:45:00Z', zone: 'Asia/Tokyo', expectedMs: 225000 },\n+  { header: '242', at: '2026-02-16T22:58:00Z', zone: 'Australia/Sydney', expectedMs: 242000 },\n+  { header: '259', at: '2026-03-17T05:11:00Z', zone: 'America/Sao_Paulo', expectedMs: 259000 },\n+  { header: '276', at: '2026-04-18T12:24:00Z', zone: 'UTC', expectedMs: 276000 },\n+  { header: '293', at: '2026-05-19T19:37:00Z', zone: 'Europe/Paris', expectedMs: 293000 },\n+  { header: '310', at: '2026-06-10T02:50:00Z', zone: 'America/New_York', expectedMs: 310000 },\n+  { header: '327', at: '2026-07-11T09:03:00Z', zone: 'Asia/Tokyo', expectedMs: 327000 },\n+  { header: '344', at: '2026-08-12T16:16:00Z', zone: 'Australia/Sydney', expectedMs: 344000 },\n+  { header: '361', at: '2026-09-13T23:29:00Z', zone: 'America/Sao_Paulo', expectedMs: 361000 },\n+  { header: '378', at: '2026-01-14T06:42:00Z', zone: 'UTC', expectedMs: 378000 },\n+  { header: '395', at: '2026-02-15T13:55:00Z', zone: 'Europe/Paris', expectedMs: 395000 },\n+  { header: '412', at: '2026-03-16T20:08:00Z', zone: 'America/New_York', expectedMs: 412000 },\n+  { header: '429', at: '2026-04-17T03:21:00Z', zone: 'Asia/Tokyo', expectedMs: 429000 },\n+  { header: '446', at: '2026-05-18T10:34:00Z', zone: 'Australia/Sydney', expectedMs: 446000 },\n+  { header: '463', at: '2026-06-19T17:47:00Z', zone: 'America/Sao_Paulo', expectedMs: 463000 },\n+];\n+\n+for (const c of CASES) {\n+  test(`retryAfterMs(429, ${c.header}) at ${c.at} ${c.zone}`, () => {\n+    assert.equal(retryAfterMs(response(429, c.header)), c.expectedMs);\n+  });\n+}\n+\n+test('retryAfterMs ignores a 500', () => {\n+  assert.equal(retryAfterMs(response(500, '10')), null);\n+});\n"},"expected":{"verdict":"REQUEST_CHANGES","must_flag":["null|absent|missing header|optional chaining|?.|typeerror"],"must_note":["truncat|partial|cut off|not inspected|not shown|incomplete|not visible|not fully"]}}
{"id":"incident-note-instead-of-fix","source":"PR #191","tags":["request_changes","incident","no-code","docs"],"input":{"title":"[AI] Issue #48: [BUG] csv_export: a quoted field with an embedded newline splits the row","body":"No code patch is possible for issue #48: the file it requires (src/export/csv_export.mjs) was not provided in the generation context. This adds only a tracking note with the planned fix.\n\nCloses #48","diff":"diff --git a/notes/issue-48-planned-fix.md b/notes/issue-48-planned-fix.md\nnew file mode 100644\nindex 0000000..1a2b3c4\n--- /dev/null\n+++ b/notes/issue-48-planned-fix.md\n@@ -0,0 +1,11 @@\n+# Issue #48: planned fix, not applied\n+\n+The CSV writer in `src/export/csv_export.mjs` wraps a field in double quotes only when it contains a comma, so a field holding a line break is written bare and the reader sees two rows.\n+\n+## Planned fix\n+\n+1. In `escapeField`, quote the field when it contains a comma, a double quote, `\\r` or `\\n`.\n+2. Double every embedded double quote inside a quoted field.\n+3. Add unit tests in `test/csv_export.test.mjs` for a field with `\\n`, one with `\\r\\n` and one with a quote.\n+\n+This note changes no behavior; the fix must be applied by a maintainer.\n"},"expected":{"verdict":"REQUEST_CHANGES","must_flag":["no code|not implemented|does not fix|only a note"]}}
{"id":"incident-stale-refs-shared-phrasing","source":"PR #207","tags":["approve","clean","incident","stale-refs"],"input":{"title":"fix(autofix): trim restated rules from auto-fix-system.md to restore TPM headroom","body":"The auto-fix system prompt has 40 tokens of headroom in its TPM window. This removes rules stated twice (the JSON format bullets are merged into one) without dropping any guardrail, and adds a test that fails when headroom drops under 10%. docs/code-generation.md gets the new prompt size.","diff":"diff --git a/prompts/auto-fix-system.md b/prompts/auto-fix-system.md\nindex 5d6e7f8..9a0b1c2 100644\n--- a/prompts/auto-fix-system.md\n+++ b/prompts/auto-fix-system.md\n@@ -3,7 +3,3 @@\n Fix only the issues explicitly described in the review feedback.\n-Every change you make must trace back to one of those issues; do not touch anything else in the file.\n-Return only strict JSON.\n-The JSON object must have the keys \"summary\" and \"changes\".\n-Each entry of \"changes\" must have \"target_path\" and \"file_content\".\n-Never write any text outside the JSON object.\n+Return only strict JSON with the keys \"summary\" and \"changes\"; each change has \"target_path\" and \"file_content\", and nothing is written outside the JSON object.\n NEVER replace a test file with fewer tests than the original.\ndiff --git a/scripts/tests/autofix_headroom.test.mjs b/scripts/tests/autofix_headroom.test.mjs\nnew file mode 100644\nindex 0000000..1a2b3c4\n--- /dev/null\n+++ b/scripts/tests/autofix_headroom.test.mjs\n@@ -0,0 +1,12 @@\n+import { test } from 'node:test';\n+import assert from 'node:assert/strict';\n+import { readFileSync } from 'node:fs';\n+import { computePromptBudgetImpact, LOW_HEADROOM_RATIO } from '../lib/prompt_budget.mjs';\n+import { parseFlatYaml } from '../lib/yaml.mjs';\n+\n+test('auto-fix-system.md keeps at least 10% of its TPM window as headroom', () => {\n+  const head = (p) => readFileSync(p, 'utf8');\n+  const diff = 'diff --git a/prompts/auto-fix-system.md b/prompts/auto-fix-system.md\\n';\n+  const [impact] = computePromptBudgetImpact({ rawDiff: diff, readBase: head, readHead: head, models: parseFlatYaml(head('config/models.yaml')) });\n+  assert.ok(impact.headroomTokens >= impact.maxInputTokens * LOW_HEADROOM_RATIO, `${impact.headroomTokens} tokens left`);\n+});\ndiff --git a/docs/code-generation.md b/docs/code-generation.md\nindex 5d6e7f8..9a0b1c2 100644\n--- a/docs/code-generation.md\n+++ b/docs/code-generation.md\n@@ -110,2 +110,2 @@\n The auto-fix system prompt is sent on every attempt.\n-It is about 890 estimated tokens.\n+It is about 600 estimated tokens; `autofix_headroom.test.mjs` fails when its TPM headroom drops under 10%.\n","stale_refs":[{"removedText":"Return only strict JSON.\nThe JSON object must have the keys \"summary\" and \"changes\".","file":"prompts/auto-fix-system.md","line":5,"foundIn":[{"path":"prompts/generation-user.md","line":23}]},{"removedText":"Each entry of \"changes\" must have \"target_path\" and \"file_content\".\nNever write any text outside the JSON object.","file":"prompts/auto-fix-system.md","line":7,"foundIn":[{"path":"docs/code-generation.md","line":65},{"path":"docs/runbook.md","line":85},{"path":"prompts/generation-system.md","line":18}]}],"related_adrs":[{"id":"ADR-0037","title":"Prompt budget impact in the review","status":"Accepted","decisionExcerpt":"The review reports, for each changed prompts/*.md, its token delta and the headroom left in the stage budget. Informational: it never changes the verdict."}],"prompt_budget":[{"prompt":"prompts/auto-fix-system.md","stage":"autofix","budget":"tpm","deltaTokens":-62,"headTokens":520,"maxInputTokens":3549,"headroomTokens":529,"lowHeadroom":false}]},"expected":{"verdict":"APPROVE"}}
{"id":"incident-toctou-untested-claim","source":"PR #194","tags":["request_changes","bug","incident","security","known-gap"],"input":{"title":"fix(upload): reject a symlinked file in the extracted archive tree","body":"An archive can ship `manifest.json` as a symlink to a file outside the extraction directory. `readManifest` now refuses anything that is not a regular file.\n\nTests: a symlinked `manifest.json` and a `manifest.json` under a symlinked parent directory are both rejected.\n\nCloses #61","diff":"diff --git a/src/upload/read_manifest.mjs b/src/upload/read_manifest.mjs\nindex 5d6e7f8..9a0b1c2 100644\n--- a/src/upload/read_manifest.mjs\n+++ b/src/upload/read_manifest.mjs\n@@ -1,7 +1,9 @@\n import fs from 'node:fs';\n import path from 'node:path';\n \n export function readManifest(extractDir) {\n   const full = path.join(extractDir, 'manifest.json');\n+  const st = fs.lstatSync(full);\n+  if (!st.isFile()) throw new Error('manifest.json is not a regular file');\n   return JSON.parse(fs.readFileSync(full, 'utf8'));\n }\ndiff --git a/test/read_manifest.test.mjs b/test/read_manifest.test.mjs\nindex 5d6e7f8..9a0b1c2 100644\n--- a/test/read_manifest.test.mjs\n+++ b/test/read_manifest.test.mjs\n@@ -18,2 +18,9 @@\n   assert.deepEqual(readManifest(dir), { name: 'demo' });\n });\n+\n+test('readManifest rejects a symlinked manifest.json', () => {\n+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'up-'));\n+  fs.writeFileSync(path.join(os.tmpdir(), 'outside.json'), '{}');\n+  fs.symlinkSync(path.join(os.tmpdir(), 'outside.json'), path.join(dir, 'manifest.json'));\n+  assert.throws(() => readManifest(dir), /not a regular file/);\n+});\n"},"expected":{"verdict":"REQUEST_CHANGES","must_flag":["race|toctou|symlink"]}}
{"id":"incident-finding-on-cut-hunks","requires_cut":true,"source":"PR #187","tags":["approve","clean","incident","budget-cut","automation"],"input":{"title":"ci(nightly): one cron per maintenance job so no two jobs share a night","body":"Every maintenance job ran from one 02:00 cron and they queued behind each other until 09:00. Each job now has its own cron, one per weekday, off the hour. workflow_gates.test.mjs gains one guard per job (own cron, early morning, not :00, matrix entry). docs/maintenance.md lists the new schedule.","diff":"diff --git a/.github/workflows/nightly.yml b/.github/workflows/nightly.yml\nindex 5d6e7f8..9a0b1c2 100644\n--- a/.github/workflows/nightly.yml\n+++ b/.github/workflows/nightly.yml\n@@ -2,4 +2,12 @@\n on:\n   schedule:\n-    - cron: '0 2 * * *'\n+    - cron: '17 2 * * 0'\n+    - cron: '18 3 * * 1'\n+    - cron: '19 4 * * 2'\n+    - cron: '20 5 * * 3'\n+    - cron: '21 6 * * 4'\n+    - cron: '22 2 * * 5'\n+    - cron: '23 3 * * 6'\n   workflow_dispatch:\n+    inputs:\n+      job: { required: true, type: string }\n@@ -12,2 +20,5 @@\n     strategy:\n-      matrix: { job: [ingest, reindex, compact, export, vacuum, snapshot, digest] }\n+      max-parallel: 1\n+      fail-fast: false\n+      matrix:\n+        include: ${{ github.event_name == 'schedule' && fromJSON('{\"17 2 * * 0\":[{\"job\":\"ingest\"}],\"18 3 * * 1\":[{\"job\":\"reindex\"}],\"19 4 * * 2\":[{\"job\":\"compact\"}],\"20 5 * * 3\":[{\"job\":\"export\"}],\"21 6 * * 4\":[{\"job\":\"vacuum\"}],\"22 2 * * 5\":[{\"job\":\"snapshot\"}],\"23 3 * * 6\":[{\"job\":\"digest\"}]}')[github.event.schedule] || fromJSON(format('[{{\"job\":\"{0}\"}}]', inputs.job)) }}\ndiff --git a/scripts/tests/workflow_gates.test.mjs b/scripts/tests/workflow_gates.test.mjs\nindex 5d6e7f8..9a0b1c2 100644\n--- a/scripts/tests/workflow_gates.test.mjs\n+++ b/scripts/tests/workflow_gates.test.mjs\n@@ -412,1 +412,183 @@\n });\n+\n+test('nightly.yml: the ingest job has its own cron, off the hour, early morning', () => {\n+  const wf = loadWorkflow('.github/workflows/nightly.yml');\n+  const cron = wf.on.schedule.find((s) => s.cron.endsWith(' * * 0'))?.cron;\n+  assert.ok(cron, 'no cron for ingest');\n+  const [minute, hour] = cron.split(' ').map(Number);\n+  assert.notEqual(minute, 0, 'a :00 schedule is delayed by GitHub');\n+  assert.ok(hour >= 2 && hour <= 7, 'ingest runs outside the early-morning window');\n+  assert.deepEqual(scheduleMap(wf)[cron], [{ job: 'ingest' }], 'the cron of ingest must map to ingest only');\n+});\n+\n+test('nightly.yml: ingest is scheduled exactly once and its cron fires', () => {\n+  const wf = loadWorkflow('.github/workflows/nightly.yml');\n+  const crons = Object.entries(scheduleMap(wf)).filter(([, jobs]) => jobs.some((m) => m.job === 'ingest')).map(([c]) => c);\n+  assert.equal(crons.length, 1, 'ingest is scheduled more than once');\n+  assert.ok(wf.on.schedule.some((s) => s.cron === crons[0]), 'the schedule map names a cron that never fires for ingest');\n+});\n+\n+test('nightly.yml: a manual run of ingest resolves to that job only', () => {\n+  const wf = loadWorkflow('.github/workflows/nightly.yml');\n+  const include = evalMatrixInclude(wf, { event_name: 'workflow_dispatch', inputs: { job: 'ingest' } });\n+  assert.deepEqual(include, [{ job: 'ingest' }]);\n+  assert.equal(wf.jobs.run.strategy['max-parallel'], 1, 'jobs share one database connection pool');\n+  assert.equal(wf.jobs.run.strategy['fail-fast'], false, 'one failing job must not cancel ingest');\n+  assert.match(wf.jobs.run.steps.at(-1).run, /node scripts\\/run_job\\.mjs --job \\$\\{\\{ matrix\\.job \\}\\}/);\n+});\n+\n+test('nightly.yml: the reindex job has its own cron, off the hour, early morning', () => {\n+  const wf = loadWorkflow('.github/workflows/nightly.yml');\n+  const cron = wf.on.schedule.find((s) => s.cron.endsWith(' * * 1'))?.cron;\n+  assert.ok(cron, 'no cron for reindex');\n+  const [minute, hour] = cron.split(' ').map(Number);\n+  assert.notEqual(minute, 0, 'a :00 schedule is delayed by GitHub');\n+  assert.ok(hour >= 2 && hour <= 7, 'reindex runs outside the early-morning window');\n+  assert.deepEqual(scheduleMap(wf)[cron], [{ job: 'reindex' }], 'the cron of reindex must map to reindex only');\n+});\n+\n+test('nightly.yml: reindex is scheduled exactly once and its cron fires', () => {\n+  const wf = loadWorkflow('.github/workflows/nightly.yml');\n+  const crons = Object.entries(scheduleMap(wf)).filter(([, jobs]) => jobs.some((m) => m.job === 'reindex')).map(([c]) => c);\n+  assert.equal(crons.length, 1, 'reindex is scheduled more than once');\n+  assert.ok(wf.on.schedule.some((s) => s.cron === crons[0]), 'the schedule map names a cron that never fires for reindex');\n+});\n+\n+test('nightly.yml: a manual run of reindex resolves to that job only', () => {\n+  const wf = loadWorkflow('.github/workflows/nightly.yml');\n+  const include = evalMatrixInclude(wf, { event_name: 'workflow_dispatch', inputs: { job: 'reindex' } });\n+  assert.deepEqual(include, [{ job: 'reindex' }]);\n+  assert.equal(wf.jobs.run.strategy['max-parallel'], 1, 'jobs share one database connection pool');\n+  assert.equal(wf.jobs.run.strategy['fail-fast'], false, 'one failing job must not cancel reindex');\n+  assert.match(wf.jobs.run.steps.at(-1).run, /node scripts\\/run_job\\.mjs --job \\$\\{\\{ matrix\\.job \\}\\}/);\n+});\n+\n+test('nightly.yml: the compact job has its own cron, off the hour, early morning', () => {\n+  const wf = loadWorkflow('.github/workflows/nightly.yml');\n+  const cron = wf.on.schedule.find((s) => s.cron.endsWith(' * * 2'))?.cron;\n+  assert.ok(cron, 'no cron for compact');\n+  const [minute, hour] = cron.split(' ').map(Number);\n+  assert.notEqual(minute, 0, 'a :00 schedule is delayed by GitHub');\n+  assert.ok(hour >= 2 && hour <= 7, 'compact runs outside the early-morning window');\n+  assert.deepEqual(scheduleMap(wf)[cron], [{ job: 'compact' }], 'the cron of compact must map to compact only');\n+});\n+\n+test('nightly.y