{"id":"incident-clean-code-cut","source":"PR #206","tags":["withheld","clean","incident","budget-cut"],"input":{"title":"feat(http): classify response status codes for the retry policy","body":"Adds `src/http/status_class.mjs`: a status → class table (informational, success, redirect, client error, server error) and `isRetryable(status)` (429 and 5xx except 501). `fetch_with_retry.mjs` now asks `isRetryable` instead of its inline `status >= 500` check, so 429 is retried. Unit tests for every class and for unknown codes.\n\nCloses #73","diff":"diff --git a/src/http/fetch_with_retry.mjs b/src/http/fetch_with_retry.mjs\nindex 5d6e7f8..9a0b1c2 100644\n--- a/src/http/fetch_with_retry.mjs\n+++ b/src/http/fetch_with_retry.mjs\n@@ -1,1 +1,2 @@\n+import { isRetryable } from './status_class.mjs';\n import { sleep } from './sleep.mjs';\n@@ -14,3 +15,3 @@\n     const res = await fetch(url, options);\n-    if (res.status < 500 || attempt === maxAttempts) return res;\n+    if (!isRetryable(res.status) || attempt === maxAttempts) return res;\n     await sleep(backoffMs * 2 ** (attempt - 1));\ndiff --git a/src/http/status_class.mjs b/src/http/status_class.mjs\nnew file mode 100644\nindex 0000000..1a2b3c4\n--- /dev/null\n+++ b/src/http/status_class.mjs\n@@ -0,0 +1,273 @@\n+// Status code → class, for the retry policy. Unknown codes are classified by their hundreds digit.\n+export const STATUS_CLASS = Object.freeze({\n+  100: 'informational', // 100 response, class 1xx\n+  101: 'informational', // 101 response, class 1xx\n+  102: 'informational', // 102 response, class 1xx\n+  103: 'informational', // 103 response, class 1xx\n+  104: 'informational', // 104 response, class 1xx\n+  105: 'informational', // 105 response, class 1xx\n+  106: 'informational', // 106 response, class 1xx\n+  107: 'informational', // 107 response, class 1xx\n+  108: 'informational', // 108 response, class 1xx\n+  109: 'informational', // 109 response, class 1xx\n+  110: 'informational', // 110 response, clas