tedMs: 2400 }, // doubling: 1200 x 2^1\n+  { attempt: 3, baseMs: 1200, expectedMs: 4800 }, // doubling: 1200 x 2^2\n+  { attempt: 4, baseMs: 1200, expectedMs: 9600 }, // doubling: 1200 x 2^3\n+  { attempt: 5, baseMs: 1200, expectedMs: 19200 }, // doubling: 1200 x 2^4\n+  { attempt: 6, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^5\n+  { attempt: 7, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^6\n+  { attempt: 8, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^7\n+  { attempt: 9, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^8\n+  { attempt: 10, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^9\n+  { attempt: 11, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^10\n+  { attempt: 12, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^11\n+  { attempt: 13, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^12\n+  { attempt: 14, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^13\n+  { attempt: 15, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^14\n+  { attempt: 16, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^15\n+  { attempt: 17, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^16\n+  { attempt: 18, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^17\n+  { attempt: 19, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^18\n+  { attempt: 20, baseMs: 1200, expectedMs: 30000 }, // capped: 1200 x 2^19\n+  { attempt: 1, baseMs: 1500, expectedMs: 1500 }, // doubling: 1500 x 2^0\n+  { attempt: 2, baseMs: 1500, expectedMs: 3000 }, // doubling: 1500 x 2^1\n+  { attempt: 3, baseMs: 1500, expectedMs: 6000 }, // doubling: 1500 x 2^2\n+  { attempt: 4, baseMs: 1500, expectedMs: 12000 }, // doubling: 1500 x 2^3\n+  { attempt: 5, baseMs: 1500, expectedMs: 24000 }, // doubling: 1500 x 2^4\n+  { attempt: 6, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^5\n+  { attempt: 7, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^6\n+  { attempt: 8, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^7\n+  { attempt: 9, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^8\n+  { attempt: 10, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^9\n+  { attempt: 11, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^10\n+  { attempt: 12, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^11\n+  { attempt: 13, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^12\n+  { attempt: 14, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^13\n+  { attempt: 15, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^14\n+  { attempt: 16, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^15\n+  { attempt: 17, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^16\n+  { attempt: 18, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^17\n+  { attempt: 19, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^18\n+  { attempt: 20, baseMs: 1500, expectedMs: 30000 }, // capped: 1500 x 2^19\n+];\n+\n+test('backoffMs doubles per attempt and never exceeds the cap', () => {\n+  for (const { attempt, baseMs, expectedMs } of TABLE) {\n+    assert.equal(backoffMs(attempt, baseMs), expectedMs, `attempt ${attempt}, base ${baseMs}`);\n+    assert.ok(backoffMs(attempt, baseMs) <= MAX_BACKOFF_MS);\n+  }\n+});\n+\n+test('backoffMs uses a 500 ms base by default', () => {\n+  assert.equal(backoffMs(1), 500);\n+  assert.equal(backoffMs(3), 2000);\n+});\n+\n+test('backoffMs rejects a non-positive or fractional attempt', () => {\n+  for (const attempt of [0, -1, 1.5, NaN]) assert.throws(() => backoffMs(attempt), RangeError);\n+});\n"},"expected":{"verdict":"APPROVE","must_not_flag":["untested claim|not exercised|no test covers"]}}
