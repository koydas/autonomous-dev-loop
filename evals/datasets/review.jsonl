n+  { header: '157', at: '2026-06-11T11:53:00Z', zone: 'America/Sao_Paulo', expectedMs: 157000 },\n+  { header: '174', at: '2026-07-12T18:06:00Z', zone: 'UTC', expectedMs: 174000 },\n+  { header: '191', at: '2026-08-13T01:19:00Z', zone: 'Europe/Paris', expectedMs: 191000 },\n+  { header: '208', at: '2026-09-14T08:32:00Z', zone: 'America/New_York', expectedMs: 208000 },\n+  { header: '225', at: '2026-01-15T15:45:00Z', zone: 'Asia/Tokyo', expectedMs: 225000 },\n+  { header: '242', at: '2026-02-16T22:58:00Z', zone: 'Australia/Sydney', expectedMs: 242000 },\n+  { header: '259', at: '2026-03-17T05:11:00Z', zone: 'America/Sao_Paulo', expectedMs: 259000 },\n+  { header: '276', at: '2026-04-18T12:24:00Z', zone: 'UTC', expectedMs: 276000 },\n+  { header: '293', at: '2026-05-19T19:37:00Z', zone: 'Europe/Paris', expectedMs: 293000 },\n+  { header: '310', at: '2026-06-10T02:50:00Z', zone: 'America/New_York', expectedMs: 310000 },\n+  { header: '327', at: '2026-07-11T09:03:00Z', zone: 'Asia/Tokyo', expectedMs: 327000 },\n+  { header: '344', at: '2026-08-12T16:16:00Z', zone: 'Australia/Sydney', expectedMs: 344000 },\n+  { header: '361', at: '2026-09-13T23:29:00Z', zone: 'America/Sao_Paulo', expectedMs: 361000 },\n+  { header: '378', at: '2026-01-14T06:42:00Z', zone: 'UTC', expectedMs: 378000 },\n+  { header: '395', at: '2026-02-15T13:55:00Z', zone: 'Europe/Paris', expectedMs: 395000 },\n+  { header: '412', at: '2026-03-16T20:08:00Z', zone: 'America/New_York', expectedMs: 412000 },\n+  { header: '429', at: '2026-04-17T03:21:00Z', zone: 'Asia/Tokyo', expectedMs: 429000 },\n+  { header: '446', at: '2026-05-18T10:34:00Z', zone: 'Australia/Sydney', expectedMs: 446000 },\n+  { header: '463', at: '2026-06-19T17:47:00Z', zone: 'America/Sao_Paulo', expectedMs: 463000 },\n+];\n+\n+for (const c of CASES) {\n+  test(`retryAfterMs(429, ${c.header}) at ${c.at} ${c.zone}`, () => {\n+    assert.equal(retryAfterMs(response(429, c.header)), c.expectedMs);\n+  });\n+}\n+\n+test('retryAfterMs ignore