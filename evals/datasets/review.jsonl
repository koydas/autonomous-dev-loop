{"id":"truncated-diff-visible-bug","tags":["request_changes","bug","null","truncated"],"input":{"title":"Honour Retry-After when the GitHub API rate-limits us","body":"On a 429 or 403 with `Retry-After`, wait the given number of seconds before retrying. When the header is absent, fall back to exponential backoff. Table-driven tests over the header values we saw in production logs.\n\nCloses #320","diff":"diff --git a/src/lib/retryAfter.js b/src/lib/retryAfter.js\nnew file mode 100644\nindex 0000000..031b008\n--- /dev/null\n+++ b/src/lib/retryAfter.js\n@@ -0,0 +1,6 @@\n+/** Milliseconds to wait before retrying a rate-limited response, or null to use the default backoff. */\n+export function retryAfterMs(res) {\n+  if (res.status !== 429 && res.status !== 403) return null;\n+  const seconds = Number(res.headers.get('retry-after').trim());\n+  return Number.isFinite(seconds) && seconds >= 0 ? seconds * 1000 : null;\n+}\ndiff --git a/test/retryAfter.test.js b/test/retryAfter.test.js\nnew file mode 100644\nindex 0000000..f984c0f\n--- /dev/null\n+++ b/test/retryAfter.test.js\n@@ -0,0 +1,259 @@\n+import { test } from 'node:test';\n+import assert from 'node:assert/strict';\n+import { retryAfterMs } from '../src/lib/retryAfter.js';\n+\n+const response = (status, header) => ({ status, headers: new Headers(header == null ? {} : { 'retry-after': header }) });\n+\n+// Header values captured from production 429s (anonymised timestamps and zones).\n+const CASES = [\n+  { header: '0', at: '2026-01-10T00:00:00Z', zone: 'UTC', expectedMs: 0 },\n+  { header: '17', at: '2026-02-11T07:13:00Z', zone: 'Europe/Paris', expectedMs: 17000 },\n+  { header: '34', at: '2026-03-12T14:26:00Z', zone: 'America/New_York', expectedMs: 34000 },\n+  { header: '51', at: '2026-04-13T21:39:00Z', zone: 'Asia/Tokyo', expectedMs: 51000 },\n+  { header: '68', at: '2026-05-14T04:52:00Z', zone: 'Australia/Sydney', expectedMs: 68000 },\n+  { header: '85', at: '2026-06-15T11:05:00Z', zone: 'America/Sao_Paulo', exp