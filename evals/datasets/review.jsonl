{"id":"incident-removed-test-case","source":"PR #276","tags":["request_changes","incident","findings","known-gap","deleted-test","repo-rule"],"input":{"title":"refactor: stop embedding the gated module list in the review prompt","body":"The review prompt used to carry a copy of the gated module list that a helper kept in step. The prompt now reads the list from the context line built from the config, so the two helpers that wrote the copy are retired.\n\nNo behavior change for reviews.","diff":"diff --git a/scripts/lib/gate_list.mjs b/scripts/lib/gate_list.mjs\nindex 080c224..d58a253 100644\n--- a/scripts/lib/gate_list.mjs\n+++ b/scripts/lib/gate_list.mjs\n@@ -4,14 +4,3 @@ import fs from 'node:fs';\n export function loadGated(configPath) {\n   return JSON.parse(fs.readFileSync(configPath, 'utf8')).gates;\n }\n-\n-// The list as prose, for the review prompt.\n-export function gatedFilesProse(gates) {\n-  return gates.map((g) => `\\`${g}\\``).join(', ');\n-}\n-\n-// Rewrites the marked block of the prompt with the current list.\n-export function syncGatePrompt(prompt, gates) {\n-  const block = `<!-- gates -->\\n${gatedFilesProse(gates)}\\n<!-- /gates -->`;\n-  return prompt.replace(/<!-- gates -->[\\s\\S]*<!-- \\/gates -->/, block);\n-}\ndiff --git a/scripts/tests/gate_list.test.mjs b/scripts/tests/gate_list.test.mjs\nindex 7190aad..4a8a438 100644\n--- a/scripts/tests/gate_list.test.mjs\n+++ b/scripts/tests/gate_list.test.mjs\n@@ -3,7 +3,7 @@ import assert from 'node:assert/strict';\n import fs from 'node:fs';\n import os from 'node:os';\n import path from 'node:path';\n-import { loadGated, gatedFilesProse, syncGatePrompt } from '../lib/gate_list.mjs';\n+import { loadGated } from '../lib/gate_list.mjs';\n \n const config = (gates) => {\n   const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'gates-')), 'gates.json');\n@@ -20,9 +20,3 @@ test('loadGated fails on a config that is not JSON', () => {\n   fs.writeFileSync(file, 'not json');\n   assert.throws(() => loadGated(file));\n });\n-\n-test('gatedFilesProse and syncGatePrompt rewrite only the marked block', () => {\n-  assert.equal(gatedFilesProse(['a.mjs', 'b.mjs']), '`a.mjs`, `b.mjs`');\n-  const prompt = 'before\\n<!-- gates -->\\nold\\n<!-- /gates -->\\nafter';\n-  assert.equal(syncGatePrompt(prompt, ['a.mjs']), 'before\\n<!-- gates -->\\n`a.mjs`\\n<!-- /gates -->\\nafter');\n-});\n"},"expected":{"verdict":"REQUEST_CHANGES","findings":[{"id":"BUG-1","path":"scripts/tests/gate_list.test.mjs","severity":"high","match":"deleted|removed|fewer|dropped|lost|retire|reduc|shrink","needs":"context"}]}}
{"id":"incident-low-continuation-axes","source":"PR #276","tags":["request_changes","incident","findings","known-gap","bug","parser"],"input":{"title":"feat: record the axes of blocking findings as signals","body":"Reads the `Axis:` tag of the High and Medium findings of a review so the loop can count which axes keep failing. Low findings are advisory and must not count.\n\nTests cover a High finding and a one-line Low finding.","diff":"diff --git a/src/review/finding_axes.mjs b/src/review/finding_axes.mjs\nnew file mode 100644\nindex 0000000..2d521e8\n--- /dev/null\n+++ b/src/review/finding_axes.mjs\n@@ -0,0 +1,25 @@\n+// Axes tagged on the blocking findings (High or Medium) of a review: the signals the meta-loop counts.\n+const AXES = ['robustness', 'side_effects', 'types', 'issue_fit'];\n+const ISSUES_HEADING = /^#{1,3}\\s.*issues found/i;\n+const OTHER_HEADING = /^#{1,3}\\s/;\n+const BLOCKING_START = /^\\s*[-*]\\s*\\[?(High|Medium)\\b/i;\n+const BULLET = /^\\s*[-*]\\s/;\n+const AXIS_TAG = /\\bAxis:\\s*([a-z_]+)/i;\n+\n+export function blockingAxes(review) {\n+  const findings = [];\n+  let inIssues = false;\n+  for (const line of String(review).split('\\n')) {\n+    if (ISSUES_HEADING.test(line)) inIssues = true;\n+    else if (OTHER_HEADING.test(line)) inIssues = false;\n+    else if (inIssues && BLOCKING_START.test(line)) findings.push(line);\n+    else if (inIssues && findings.length && !BULLET.test(line)) findings[findings.length - 1] += `\\n${line}`;\n+    else if (inIssues) findings.push('');\n+  }\n+  const found = new Set();\n+  for (const finding of findings) {\n+    const tag = finding.match(AXIS_TAG)?.[1]?.toLowerCase();\n+    if (tag) found.add(tag);\n+  }\n+  return AXES.filter((axis) => found.has(axis));\n+}\ndiff --git a/src/review/finding_axes.test.mjs b/src/review/finding_axes.test.mjs\nnew file mode 100644\nindex 0000000..43f6667\n--- /dev/null\n+++ b/src/review/finding_axes.test.mjs\n@@ -0,0 +1,13 @@\n+import { test } from 'node:test';\n+import assert from 'node:assert/strict';\n+import { blockingAxes } from './finding_axes.mjs';\n+\n+const review = (...lines) => ['### Issues Found', ...lines, ''].join('\\n');\n+\n+test('a High finding contributes its axis', () => {\n+  assert.deepEqual(blockingAxes(review('- [High] Bug — File: a.mjs Lines: 1 Axis: robustness')), ['robustness']);\n+});\n+\n+test('a Low finding on one line contributes nothing', () => {\n+  assert.deepEqual(blockingAxes(review('- [Low] Note — File: a.mjs Lines: 1 Axis: types')), []);\n+});\n"},"expected":{"verdict":"REQUEST_CHANGES","findings":[{"id":"BUG-1","path":"src/review/finding_axes.mjs","severity":"medium","lines":[16,17],"match":"low|continuation|multi|non-blocking|nonblocking|second line|wrapped|advisory","needs":"reasoning"}]}}
{"id":"incident-docs-contradict-new-behavior","source":"PR #279","tags":["request_changes","incident","findings","known-gap","stale-docs"],"input":{"title":"feat(evals): the review suite scores the verdict production publishes","body":"The suite stopped before the adversarial protocol that production applies, so an approval without the analysis scored APPROVE in the eval and was published WITHHELD. The three stages now live in one function used by both.\n\nTests cover each outcome. The eval docs and the changelog are updated.","diff":"diff --git a/CHANGELOG.md b/CHANGELOG.md\nindex 74389e0..4609fcd 100644\n--- a/CHANGELOG.md\n+++ b/CHANGELOG.md\n@@ -2,4 +2,5 @@\n \n ## [Unreleased]\n \n+- **Evals: the review suite scores the verdict production publishes.** One function, `resolveDecision`, applies evidence, cut code and the adversarial protocol for both.\n - Dashboard: the home fits one screen.\ndiff --git a/docs/evals.md b/docs/evals.md\nindex 2b02ad2..b06d88f 100644\n--- a/docs/evals.md\n+++ b/docs/evals.md\n@@ -2,5 +2,5 @@\n \n The suite replays the recorded model answers through the production parser.\n \n-- The `review` suite stops at the evidence and cut-code stages.\n+- The `review` suite resolves the verdict through `resolveDecision`, the function production uses: evidence, cut code, then the adversarial protocol.\n - Cases tagged `known-gap` run but are not gated.\ndiff --git a/scripts/lib/eval_suites.mjs b/scripts/lib/eval_suites.mjs\nindex dcaf159..c5d587d 100644\n--- a/scripts/lib/eval_suites.mjs\n+++ b/scripts/lib/eval_suites.mjs\n@@ -1,7 +1,6 @@\n-import { decideVerdict } from './review_evidence.mjs';\n-import { withholdOnUnreviewedCode } from './review_prompt.mjs';\n+import { resolveDecision } from './review_decision.mjs';\n \n-// Verdict the review suite scores: evidence, then code cut from the diff.\n-export function scoreReview({ llmApproved, evidence, unreviewedFiles }) {\n-  return withholdOnUnreviewedCode(decideVerdict(llmApproved, evidence), unreviewedFiles);\n+// Verdict the review suite scores: the same decision production publishes.\n+export function scoreReview(input) {\n+  return resolveDecision(input);\n }\ndiff --git a/scripts/lib/review_decision.mjs b/scripts/lib/review_decision.mjs\nnew file mode 100644\nindex 0000000..0ed84be\n--- /dev/null\n+++ b/scripts/lib/review_decision.mjs\n@@ -0,0 +1,10 @@\n+import { decideVerdict } from './review_evidence.mjs';\n+import { withholdOnUnreviewedCode } from './review_prompt.mjs';\n+import { enforceProtocol } from './protocol.mjs';\n+\n+// Evidence, then code cut from the diff, then the adversarial protocol: one place for production and the suite.\n+export function resolveDecision({ llmApproved, evidence, unreviewedFiles, analysis }) {\n+  const byEvidence = decideVerdict(llmApproved, evidence);\n+  const byCut = withholdOnUnreviewedCode(byEvidence, unreviewedFiles);\n+  return enforceProtocol(byCut, analysis);\n+}\ndiff --git a/scripts/tests/review_decision.test.mjs b/scripts/tests/review_decision.test.mjs\nnew file mode 100644\nindex 0000000..c3ed0ce\n--- /dev/null\n+++ b/scripts/tests/review_decision.test.mjs\n@@ -0,0 +1,13 @@\n+import { test } from 'node:test';\n+import assert from 'node:assert/strict';\n+import { resolveDecision } from '../lib/review_decision.mjs';\n+\n+const ok = { llmApproved: true, evidence: { state: 'available', failing: [], unverified: [] }, unreviewedFiles: [] };\n+\n+test('an approval that names two risks is approved', () => {\n+  assert.equal(resolveDecision({ ...ok, analysis: { criticalPoints: 2 } }).verdict, 'APPROVE');\n+});\n+\n+test('an approval that names none is withheld', () => {\n+  assert.equal(resolveDecision({ ...ok, analysis: { criticalPoints: 0 } }).verdict, 'WITHHELD');\n+});\n"},"expected":{"verdict":"REQUEST_CHANGES","findings":[{"id":"BUG-1","path":"docs/code-generation.md","severity":"medium","match":"doc|stale|outdated|still|contradict|no longer","needs":"context"}]}}
{"id":"incident-grader-first-push","source":"PR #283","tags":["request_changes","incident","findings","known-gap","bug","multi-bug","security"],"input":{"title":"feat(evals): grade a generated patch against hidden tests","body":"Applies a model-produced patch to a pinned fixture and decides, with tests the model never saw, whether it is correct. The fixture and the hidden tests are pinned by digest, the hidden tests are copied in after the patch, and the existing and hidden suites run in the patched copy.\n\nNothing calls it yet. Tests cover the digest and a passing grade.","diff":"diff --git a/src/grader/runner.mjs b/src/grader/runner.mjs\nnew file mode 100644\nindex 0000000..f610264\n--- /dev/null\n+++ b/src/grader/runner.mjs\n@@ -0,0 +1,76 @@\n+import { createHash } from 'node:crypto';\n+import fs from 'node:fs/promises';\n+import os from 'node:os';\n+import path from 'node:path';\n+\n+async function listFiles(root, rel = '') {\n+  const out = [];\n+  for (const entry of await fs.readdir(path.join(root, rel), { withFileTypes: true })) {\n+    const p = rel ? `${rel}/${entry.name}` : entry.name;\n+    if (entry.isSymbolicLink()) out.push({ path: p, link: await fs.readlink(path.join(root, p)) });\n+    else if (entry.isDirectory()) out.push(...(await listFiles(root, p)));\n+    else out.push({ path: p });\n+  }\n+  return out;\n+}\n+\n+// Digest of a directory: paths, contents and link targets.\n+export async function digestTree(root) {\n+  const h = createHash('sha256');\n+  for (const f of (await listFiles(root)).sort((a, b) => (a.path < b.path ? -1 : 1))) {\n+    h.update(`${f.path}\\0`);\n+    h.update(f.link !== undefined ? `link:${f.link}` : await fs.readFile(path.join(root, f.path)));\n+    h.update('\\0');\n+  }\n+  return h.digest('hex');\n+}\n+\n+// Copies the fixture to a temporary directory and writes the patch there.\n+export async function applyPatch(fixtureDir, changes) {\n+  const work = await fs.mkdtemp(path.join(os.tmpdir(), 'run-'));\n+  await fs.cp(fixtureDir, work, { recursive: true });\n+  for (const { targetPath, content } of changes) {\n+    await fs.mkdir(path.dirname(path.join(work, targetPath)), { recursive: true });\n+    await fs.writeFile(path.join(work, targetPath), content);\n+  }\n+  return work;\n+}\n+\n+// Puts the hidden tests back after the patch was applied.\n+export async function restoreHidden(workDir, hiddenDir, files) {\n+  for (const f of files) {\n+    await fs.mkdir(path.dirname(path.join(workDir, f)), { recursive: true });\n+    await fs.copyFile(path.join(hiddenDir, f), path.join(workDir, f));\n+  }\n+}\n+\n+// Runs the existing tests, then the hidden ones, in the patched copy.\n+export async function runSuites(workDir, commands, exec) {\n+  const home = await fs.mkdtemp(path.join(os.tmpdir(), 'home-'));\n+  try {\n+    for (const command of commands) {\n+      const result = await exec(command, { cwd: workDir, env: { HOME: home, TMPDIR: home } });\n+      if (result.exitCode !== 0) return { passed: false, command };\n+    }\n+    return { passed: true };\n+  } finally {\n+    await fs.rm(home, { recursive: true, force: true });\n+  }\n+}\n+\n+// Grades one patch: pinned inputs, patch, hidden tests, test commands.\n+export async function gradePatch(input, exec) {\n+  if ((await digestTree(input.fixtureDir)) !== input.fixtureDigest) return { outcome: 'ERROR', reason: 'fixture changed' };\n+  if ((await digestTree(input.hiddenDir)) !== input.hiddenDigest) return { outcome: 'ERROR', reason: 'hidden tests changed' };\n+  let work;\n+  try {\n+    work = await applyPatch(input.fixtureDir, input.changes);\n+    await restoreHidden(work, input.hiddenDir, input.hiddenFiles);\n+    const run = await runSuites(work, input.commands, exec);\n+    return { outcome: run.passed ? 'PASS' : 'FAIL', command: run.command };\n+  } catch (err) {\n+    return { outcome: 'ERROR', reason: err.message };\n+  } finally {\n+    if (work) await fs.rm(work, { recursive: true, force: true });\n+  }\n+}\ndiff --git a/src/grader/runner.test.mjs b/src/grader/runner.test.mjs\nnew file mode 100644\nindex 0000000..9decd8b\n--- /dev/null\n+++ b/src/grader/runner.test.mjs\n@@ -0,0 +1,23 @@\n+import { test } from 'node:test';\n+import assert from 'node:assert/strict';\n+import fs from 'node:fs/promises';\n+import os from 'node:os';\n+import path from 'node:path';\n+import { digestTree, gradePatch } from './runner.mjs';\n+\n+const tree = async (files) => {\n+  const dir = await fs.mkdtemp(path.join(os.tmpdir(), 'tree-'));\n+  for (const [name, content] of Object.entries(files)) await fs.writeFile(path.join(dir, name), content);\n+  return dir;\n+};\n+\n+test('digestTree changes with a content', async () => {\n+  assert.notEqual(await digestTree(await tree({ 'a.txt': 'x' })), await digestTree(await tree({ 'a.txt': 'y' })));\n+});\n+\n+test('gradePatch passes when every command exits 0', async () => {\n+  const fixture = await tree({ 'a.txt': 'x' });\n+  const hidden = await tree({ 'h.txt': 'h' });\n+  const result = await gradePatch({ fixtureDir: fixture, fixtureDigest: await digestTree(fixture), hiddenDir: hidden, hiddenDigest: await digestTree(hidden), changes: [], hiddenFiles: ['h.txt'], commands: ['t'] }, async () => ({ exitCode: 0 }));\n+  assert.equal(result.outcome, 'PASS');\n+});\n"},"expected":{"verdict":"REQUEST_CHANGES","findings":[{"id":"BUG-1","path":"src/grader/runner.mjs","severity":"medium","lines":[21,23],"match":"digest|hash|separator|\\0|nul|collision|ambigu|framing|length","needs":"reasoning"},{"id":"BUG-2","path":"src/grader/runner.mjs","severity":"high","lines":[63,65],"match":"throw|reject|try|error boundary|enoent|missing|unreadable|not a result|abort|uncaught","needs":"reasoning"},{"id":"BUG-3","path":"src/grader/runner.mjs","severity":"medium","lines":[30,36],"match":"leak|left behind|cleanup|clean up|remove|temporary|temp dir|mkdtemp|rm","needs":"diff"},{"id":"BUG-4","path":"src/grader/runner.mjs","severity":"high","lines":[49,55],"match":"hidden|tamper|overwrit|same director|shared|work dir|workdir|fresh|isolat|rewrite","needs":"reasoning"},{"id":"BUG-5","path":"src/grader/runner.mjs","severity":"medium","match":"symlink|symbolic|link|follow","needs":"knowledge"},{"id":"BUG-6","path":"src/grader/runner.mjs","severity":"medium","lines":[49,55],"match":"home|tmpdir|environment|env|shared|state|leak","needs":"reasoning"}]}}
{"id":"impact-caller-misses-new-parameter","tags":["request_changes","impact","findings","known-gap","bug","context"],"input":{"title":"feat: round discounted prices to the currency's minor unit","body":"Zero-decimal currencies were rounded to cents. applyDiscount takes the currency and rounds accordingly; the tests cover EUR and JPY.","diff":"diff --git a/src/pricing.mjs b/src/pricing.mjs\nindex 3b1c2aa..9d4e7f0 100644\n--- a/src/pricing.mjs\n+++ b/src/pricing.mjs\n@@ -1,6 +1,8 @@\n-export function applyDiscount(price, rate) {\n-  return Math.round(price * (1 - rate) * 100) / 100;\n+export function applyDiscount(price, rate, currency) {\n+  const digits = currency === 'JPY' ? 0 : 2;\n+  const factor = 10 ** digits;\n+  return Math.round(price * (1 - rate) * factor) / factor;\n }\n \n export function formatPrice(price) {\ndiff --git a/tests/pricing.test.mjs b/tests/pricing.test.mjs\nindex 51aa0c2..7e30b1d 100644\n--- a/tests/pricing.test.mjs\n+++ b/tests/pricing.test.mjs\n@@ -3,5 +3,6 @@ import { applyDiscount } from '../src/pricing.mjs';\n \n test('applyDiscount rounds to cents', () => {\n-  assert.equal(applyDiscount(10, 0.333), 6.67);\n+  assert.equal(applyDiscount(10, 0.333, 'EUR'), 6.67);\n+  assert.equal(applyDiscount(1000, 0.333, 'JPY'), 667);\n });\n","impact":{"symbols":[{"name":"applyDiscount","file":"src/pricing.mjs","status":"changed","refs":[{"path":"src/checkout.mjs","line":14,"text":"const due = applyDiscount(cart.subtotal, cart.rate);"},{"path":"src/checkout.mjs","line":2,"text":"import { applyDiscount } from './pricing.mjs';"}],"refFiles":1,"generic":false}],"tests":[{"path":"tests/pricing.test.mjs","changed":true}],"scanned":6,"truncated":false}},"expected":{"verdict":"REQUEST_CHANGES","findings":[{"id":"BUG-1","path":"src/pricing.mjs","severity":"high","match":"checkout|caller|currency.*(undefined|missing|omit|not pass)","needs":"context"}]}}
